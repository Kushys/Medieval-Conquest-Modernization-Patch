/* Session-local camera bookmarks. Native setters own terrain and view limits. */
typedef struct { float v[6]; U valid; } Bookmark;
static Bookmark bookmarks[4];
static U bookmark_owner,bookmark_camera,bookmark_keys,bookmark_armed;
static void bookmark_reset(void){zero(bookmarks,sizeof(bookmarks));bookmark_owner=bookmark_camera=bookmark_keys=bookmark_armed=0;}
static I bookmark_values(const float *v){for(U i=0;i<6;i++)if(!(v[i]>=-10000000.0f&&v[i]<=10000000.0f))return 0;return v[1]>=0&&v[1]<=1&&v[2]>=0&&v[2]<=1;}
static U bookmark_edges(U mask,U allowed,U *prev,U *armed){U edge=0;if(!allowed){*armed=0;}else if(!mask){*armed=1;}else if(*armed){edge=mask&~*prev;}*prev=mask;return edge;}
static I bookmark_save(U camera,U slot){float v[6];if(slot>=4||!rd(camera+0x1f4,v,sizeof(v))||!bookmark_values(v))return 0;for(U i=0;i<6;i++)bookmarks[slot].v[i]=v[i];bookmarks[slot].valid=1;begin("BOOKMARK_SAVE");num("slot",slot+1);arr("view_bits",(U*)v,6,1);emit();return 1;}
static void bookmark_recall(U camera,U slot){float current[6];B lock[3];if(slot>=4||!bookmarks[slot].valid){begin("BOOKMARK_EMPTY");num("slot",slot+1);emit();return;}if(!rd(camera+0x1dc,current,sizeof(current))||!bookmark_values(current)||!rd(camera+0x20c,lock,3)||lock[0])return;float *v=bookmarks[slot].v;typedef void (__thiscall *Position)(void*,float,float,float,U);typedef void (__thiscall *View)(void*,float);if(bookmark_restore_view){((View)0x4cefc0)((void*)camera,current[0]-v[0]);((View)0x4cf090)((void*)camera,v[1]-current[1]);((View)0x4cf030)((void*)camera,v[2]-current[2]);}((Position)0x4cec60)((void*)camera,v[3],v[4],v[5],0);begin("BOOKMARK_RECALL");num("slot",slot+1);num("restore_view",bookmark_restore_view);emit();}
static void bookmark_tick(U owner,U camera,I valid){if(!camera_bookmarks)return;U mask=0;for(U i=0;i<4;i++)if(held(0x70+i))mask|=1u<<i;if(owner!=bookmark_owner||camera!=bookmark_camera){bookmark_reset();bookmark_owner=owner;bookmark_camera=camera;}if(valid&&!bookmarks[0].valid)bookmark_save(camera,0);U edges=bookmark_edges(mask,valid&&!held(0x10)&&!held(0x12),&bookmark_keys,&bookmark_armed);for(U i=0;i<4;i++)if(edges&(1u<<i)){if(held(0x11))bookmark_save(camera,i);else bookmark_recall(camera,i);}}
/* Only replaces the call from the HUD Home button; other native jumps unchanged. */
void __thiscall bookmark_home(void *camera,float x,float y,float z,U immediate){typedef void (__thiscall *Position)(void*,float,float,float,U);if(!camera_bookmarks||!config_loaded){((Position)0x4cec60)(camera,x,y,z,immediate);return;}if(camera_context()&&(U)camera==bookmark_camera&&bookmark_owner){bookmark_recall((U)camera,0);}}
